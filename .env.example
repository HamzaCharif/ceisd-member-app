# ─────────────────────────────────────────────────────────────
# CEISD Member App — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Azure AD / Microsoft Entra ID (Auth) ─────────────────────
AZURE_CLIENT_ID=                  # App registration client ID from Azure portal
AZURE_TENANT_ID=                  # Azure AD tenant ID (or "common" for multi-tenant)
AZURE_CLIENT_SECRET=              # Client secret from Azure portal → Certificates & secrets

# ── Email Domain Enforcement ──────────────────────────────────
AUS_EMAIL_DOMAIN=aus.edu          # Only this domain is allowed access

# ── Admin Accounts ────────────────────────────────────────────
ADMIN_EMAILS=                     # Comma-separated: admin1@aus.edu,admin2@aus.edu

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ceisd?schema=public
                                  # pgvector extension must be enabled on this database

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=                       # Random 256-bit secret for signing session tokens
                                  # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
                                  # NOTE: Set this in BOTH the API and admin-web environments — they must match

# ── QR Attendance ─────────────────────────────────────────────
QR_SECRET=                        # HMAC secret for signing QR attendance tokens
                                  # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── AI (Agent 5 — Matching) ───────────────────────────────────
ANTHROPIC_API_KEY=                # Anthropic API key — used for match explanations + embeddings

# ── API URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000   # admin-web → API
EXPO_PUBLIC_API_URL=http://localhost:4000   # mobile Expo app → API
                                           # PHYSICAL DEVICE: change to your machine's LAN IP, e.g. http://192.168.1.x:4000
API_INTERNAL_URL=http://localhost:4000      # server-to-server calls (triggers, stubs)

# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001           # admin-web origin
